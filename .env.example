# ---- Database (required) -------------------------------------------------
# Free Postgres: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth.js (required) --------------------------------------------------
# Generate one with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET=""
# Set to your production URL on Vercel, e.g. https://twinklegiftsyou.in
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- First admin account (used by `npm run db:seed`) ---------------------
ADMIN_EMAIL="admin@twinklegiftsyou.in"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="TwinkleGiftsYou Admin"

# ---- Images (optional) ---------------------------------------------------
# Cloudinary free tier. Create an UNSIGNED upload preset in the dashboard.
# Without these, the admin panel still accepts pasted image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ---- Payments (optional) -------------------------------------------------
# Leave blank to run the shop in "pay on confirmation" mode only.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---- Email (optional) ----------------------------------------------------
# Resend free tier. Without a key, order/enquiry emails are simply skipped.
RESEND_API_KEY=""
RESEND_FROM="TwinkleGiftsYou <onboarding@resend.dev>"
CONTACT_NOTIFY_EMAIL=""
