# ---- Database (required) -------------------------------------------------
# Free Postgres: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ---- Auth.js (required) --------------------------------------------------
# Generate one with: npx auth secret   (or `openssl rand -base64 32`)
AUTH_SECRET=""
# Set to your production URL on Vercel, e.g. https://twinklegiftsyou.in
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- First admin account (used by `npm run db:seed`) ---------------------
ADMIN_EMAIL="admin@twinklegiftsyou.in"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="TwinkleGiftsYou Admin"

# ---- Photo uploads (optional) --------------------------------------------
# Supabase Storage, using the database you already have. The browser uploads
# straight to storage through a one-time signed URL, so the service key never
# reaches it. Without these the photo field falls back to a pasted link.
# Find both under Supabase -> Project Settings -> API.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# ---- Images (optional) ---------------------------------------------------
# Cloudinary free tier. Create an UNSIGNED upload preset in the dashboard.
# Without these, the admin panel still accepts pasted image URLs.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""

# ---- Payments ------------------------------------------------------------
# Two independent routes; set either, or both. With neither, checkout falls
# back to arranging payment over WhatsApp.
#
# 1. Direct UPI — no fees, no signup. The customer pays your VPA and quotes
#    the reference back for you to confirm against your bank.
UPI_ID=""
UPI_PAYEE_NAME="TwinkleGiftsYou"
#
# 2. Razorpay — cards, netbanking and wallets as well as UPI. Charges roughly
#    2% + GST per successful transaction.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# ---- Email (optional) ----------------------------------------------------
# Resend free tier. Without a key, order/enquiry emails are simply skipped.
RESEND_API_KEY=""
# RESEND_FROM must be an address on a domain verified in Resend. A Gmail
# address will NOT work here — Resend cannot send as gmail.com. Use the
# shared sandbox sender until twinklegiftsyou.in is verified, then switch to
# something like "TwinkleGiftsYou <orders@twinklegiftsyou.in>".
RESEND_FROM="TwinkleGiftsYou <onboarding@resend.dev>"
# Where contact-form enquiries are delivered. A Gmail address is fine here.
CONTACT_NOTIFY_EMAIL="twinklegiftsyou@gmail.com"
