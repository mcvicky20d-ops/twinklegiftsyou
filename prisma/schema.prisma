// TwinkleGiftsYou.in — data model
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  COD
}

/// How the buyer wants a personalised item made up.
enum CustomisationMode {
  NONE
  TEXT_ONLY
  IMAGE_ONLY
  TEXT_AND_IMAGE
}

/// How the buyer chose to pay.
enum PaymentMethod {
  RAZORPAY
  UPI
  PENDING
}

/// How the buyer intends to get their photograph to us.
enum ImageDelivery {
  NOT_NEEDED
  UPLOADED
  WHATSAPP
  CONTACT_ME
}

enum EnquiryStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  products    Product[]

  @@index([sortOrder])
}

model Product {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  /// Price in paise (₹499.00 => 49900) so money never touches a float.
  price        Int
  comparePrice Int?
  images       String[] @default([])
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false)
  customizable Boolean  @default(true)
  /// Which personalisation choices this product offers. A pencil portrait is
  /// drawn from a photograph, so it has no text-only option.
  customisationModes CustomisationMode[] @default([TEXT_ONLY, IMAGE_ONLY, TEXT_AND_IMAGE])
  /// Free-text hint shown next to the customisation box, e.g. "Send the photo you want sketched".
  customNote   String?
  stock        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orderItems OrderItem[]

  @@index([categoryId])
  @@index([isActive, isFeatured])
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  customerName String
  email        String
  phone        String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  pincode      String
  notes        String?

  subtotal  Int
  shipping  Int @default(0)
  total     Int

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  paymentMethod     PaymentMethod @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  /// UTR the customer quotes after paying by UPI, for staff to reconcile.
  upiReference      String?

  /// Answered by the checkout prompt, so staff know whether to expect a photo
  /// on WhatsApp or to call the customer for it.
  imageDelivery  ImageDelivery @default(NOT_NEEDED)
  /// Explicit permission to phone or message about the missing photograph.
  contactConsent Boolean       @default(false)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Title and price are copied so an order stays readable after a product is edited or deleted.
  title     String
  unitPrice Int
  quantity  Int    @default(1)

  customisationMode CustomisationMode @default(NONE)
  customText        String?
  customImageUrl    String?

  @@index([orderId])
}

model Enquiry {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String
  message String

  status    EnquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

model GalleryItem {
  id        String   @id @default(cuid())
  title     String
  imageUrl  String
  caption   String?
  tag       String   @default("Pencil Art")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}
